# Replace with a GA4 measurement ID (starts with "G-"). The value that was
# in the original .env.local (UA-219648158-1) is a Universal Analytics ID;
# UA stopped processing data in 2023, so analytics have likely been
# silently collecting nothing for a while.
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# MONGODB_URI, MONGODB_DB, ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET have
# been dropped. They belonged to pages/api/user/* and middleware.js, which
# both relied on a Next.js server - impossible under output: "export" and
# so dead code even before this migration. See README.md.
